# Copy this file to backend/.env for local development.
# Never put a real API key in Git or in chat output.
# Configure OPENAI_API_KEY, or use LLM_API_KEY for legacy compatibility.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_TIMEOUT_SECONDS=30
LLM_MODE=mock

# Backend server and upload settings.
ALLOWED_ORIGINS=http://localhost:3000
MAX_FILES=10
MAX_FILE_SIZE_MB=5
